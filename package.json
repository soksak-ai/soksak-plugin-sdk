{
  "name": "@soksak/soksak-sdk",
  "version": "0.0.2",
  "private": true,
  "engines": {
    "node": "26.7.0"
  },
  "packageManager": "pnpm@11.22.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.7.0",
      "onFail": "error"
    }
  },
  "type": "module",
  "exports": {
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./component-tools": {
      "types": "./dist/component-tools.d.ts",
      "default": "./dist/component-tools.js"
    }
  },
  "bin": {
    "soksak-sdk": "bin/soksak-sdk.mjs"
  },
  "scripts": {
    "dependencies:prepare": "node scripts/prepare-spec.mjs",
    "build": "tsc -p tsconfig.json",
    "test:unit": "pnpm build && node --test scripts/*.test.mjs && vitest run --config vitest.config.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "test": "pnpm test:unit && pnpm release:verify"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
